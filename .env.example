# Configuration design only. No services consume this file yet.
# Keep values empty until a component is implemented and its contract is verified.
NEBULA_ENV=development
NEBULA_PUBLIC_URL=
NEBULA_SESSION_SECRET=
NEBULA_DATABASE_URL=

# Server-side OpenStack project credentials; never expose these to the dashboard/LLM.
OS_AUTH_URL=
OS_REGION_NAME=
OS_INTERFACE=internal
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=
OS_CACERT=

# Restricted Stripe sandbox/test API key and a separate webhook signing secret.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_LIVE_MODE_ENABLED=false

# Endpoint and protocol must be supplied/verified with PeopleWelcome.
PEOPLEWELCOME_API_URL=
PEOPLEWELCOME_API_KEY=
PEOPLEWELCOME_MODEL=
NEBULA_ASSISTANT_MUTATIONS_ENABLED=false

# Rates are versioned in the billing database, not browser-controlled env values.
NEBULA_BILLING_CURRENCY=USD
NEBULA_USAGE_COLLECTION_INTERVAL_SECONDS=300
NEBULA_USAGE_SETTLEMENT_INTERVAL_SECONDS=3600

# Terraform credentials: export only in an approved operator provisioning session.
# TF_VAR_mnemonic is sensitive and must never be stored in Git or CI artifacts.
TF_VAR_mnemonic=
TF_VAR_grid_network=
TF_VAR_ssh_public_key=
