# Run `nebula init-env` once to generate private database/encryption secrets.
NEBULA_DB_PASSWORD=
NEBULA_DATABASE_URL=postgresql+psycopg://nebula:REPLACE@postgres:5432/nebula
NEBULA_CREDENTIAL_KEY=
NEBULA_PUBLIC_URL=http://localhost:8080
# Local loopback development only. Set true behind HTTPS on a ThreeFold app node.
NEBULA_COOKIE_SECURE=false
NEBULA_PROVISIONING_ENABLED=false
NEBULA_MAX_INSTANCES=5
NEBULA_METERING_STALE_SECONDS=900
NEBULA_WORKER_INTERVAL_SECONDS=30
NEBULA_DASHBOARD_DIST=apps/dashboard/dist

# Only restricted sandbox/test keys are accepted. Never use live mode in this pilot.
NEBULA_STRIPE_API_KEY=
NEBULA_STRIPE_WEBHOOK_SECRET=
NEBULA_STRIPE_API_VERSION=2026-09-30.endive
NEBULA_STRIPE_INTEGRATION_ID=nebula_pilot_abcdefgh

# Native PeopleWelcome v5 REST origins. No OpenAI-style API key/chat endpoint.
NEBULA_PEOPLEWELCOME_API_URL=https://peopl.ewelco.me
NEBULA_PEOPLEWELCOME_ISSUER=https://pplwlcm1-ysqkpd.us1.zitadel.cloud
# Each customer connects their own ZITADEL access token in PeopleWelcome support.
# Tokens are encrypted using NEBULA_CREDENTIAL_KEY; never put a shared token here.
# Choose an owned, active OpenAI character. PeopleWelcome selects its configured
# OpenAI model; its documented default is gpt-6-luna (not a chat request field).

# Export these only when binding a customer's existing Keystone project.
# nebula bind-project verifies the actual scope, then encrypts the credentials.
OS_APPLICATION_CREDENTIAL_ID=
OS_APPLICATION_CREDENTIAL_SECRET=

# Terraform operator session only; never commit mnemonic, plan, state or WG config.
TF_VAR_mnemonic=
